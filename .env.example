# Configuración de la aplicación
# Copia este archivo como .env y configura las variables según tu entorno

# URL base para generar links en los QR codes
# En desarrollo local con VS Code port forwarding, usa la URL pública que te da VS Code
# Ejemplo: BASE_URL=https://3000-username-repo-abc123.preview.app.github.dev
BASE_URL=

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# Entorno de ejecución
NODE_ENV=development
